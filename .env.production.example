# Copy to .env on the server and replace every placeholder. Never commit the real file.
DJANGO_SECRET_KEY=replace-with-64-or-more-random-characters
DJANGO_ALLOWED_HOSTS=sdzjoy.com,www.sdzjoy.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sdzjoy.com,https://www.sdzjoy.com
PUBLIC_SITE_ORIGIN=https://sdzjoy.com
WWW_REDIRECT_HOST=www.sdzjoy.com

POSTGRES_DB=sdzjoy
POSTGRES_USER=sdzjoy
POSTGRES_PASSWORD=replace-with-a-unique-database-password
RESTORE_POSTGRES_DB=sdzjoy_restore
RESTORE_POSTGRES_PASSWORD=replace-with-a-separate-restore-password

MFA_ENCRYPTION_KEY=replace-with-a-separate-encryption-key
IDP_OIDC_PRIVATE_KEY=replace-with-a-pem-private-key-using-literal-backslash-n
TURNSTILE_SITE_KEY=replace-with-cloudflare-site-key
TURNSTILE_SECRET_KEY=replace-with-cloudflare-secret-key
TURNSTILE_EXPECTED_HOSTNAMES=sdzjoy.com,id.sdzjoy.com

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=少惰主 <noreply@sdzjoy.com>

APP_IMAGE=ghcr.io/sdzjoy/sdz@sha256:replace-with-immutable-digest
SDZJOY_PORT=8080
BACKUP_RETENTION_DAYS=14
# Offsite upload is refused unless AGE_RECIPIENT is set.
AGE_RECIPIENT=
OFFSITE_DEST=
BACKUP_SSH_DIR=./private/backup-ssh
BACKUP_AGE_DIR=./private/backup-age
AGE_IDENTITY_FILE=/keys/identity.txt

