DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
PUBLIC_SITE_ORIGIN=http://localhost:8000
WWW_REDIRECT_HOST=

POSTGRES_DB=sdzjoy
POSTGRES_USER=sdzjoy
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
MFA_ENCRYPTION_KEY=replace-with-a-separate-long-random-encryption-key
IDP_OIDC_PRIVATE_KEY=replace-with-a-pem-private-key-using-literal-backslash-n
TURNSTILE_REQUIRED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=sdzjoy.com,id.sdzjoy.com

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=少惰主 <noreply@sdzjoy.com>
ACCOUNT_EMAIL_VERIFICATION=mandatory
